# Copiá este archivo como .env.local (desarrollo) y cargá las mismas variables en Vercel.

# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (puerto 6543)
DATABASE_URL=postgresql://postgres.xxxxxxxx:TU-CONTRASEÑA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Contraseña para entrar al sistema
APP_PASSWORD=elegí-una-contraseña-larga

# Texto largo al azar para firmar la sesión (por ejemplo, generá uno en https://generate-secret.vercel.app/32)
SESSION_SECRET=
